# Credentials for scripts/finder-agent.js — the contact finder's agent.
#
# Copy to .env and fill in. .env is gitignored and must stay that way:
# this is a real CRM login, and writes run as that person.
#
# The account needs the `admin` role in the CRM. A viewer can read
# everything and write nothing, so the agent will fail at its first
# write with a row-level-security error rather than at sign-in.
#
# AEE_EMAIL takes the same thing the sign-in box does: a plain username
# is completed to @aeeg.co.za, and anything with an @ is used as typed.

AEE_EMAIL=
AEE_PASSWORD=

# Optional. Both default to this project's own public identifiers, which
# are in js/supabase.js and grant nothing on their own. Set them only to
# point the agent at a different Supabase project.
# AEE_SUPABASE_URL=
# AEE_SUPABASE_KEY=
