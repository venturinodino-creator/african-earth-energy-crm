# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Node (not used today, but keeps a stray install out of the repo)
node_modules/
npm-debug.log*

# Secrets — never commit these
.env
.env.*
*.pem

# Local exports
*.csv
!data/*.csv

# Local agent tooling
.claude-flow/
.swarm/
memory/

# Shell-quoting debris — an unbalanced quote in a shell command makes the
# shell read fragments of JavaScript as redirection targets, creating empty
# root files named things like `[r.title` or `upsert('aee_prospects'`.
# These match the punctuation such a fragment carries and a real file never
# does. Bare-word debris (`name`, `v`, `d.id`) cannot be matched safely and
# still has to be caught by eye — `git clean -n` lists it.
/*'*
/*"*
/*(*
/*)*
/*\[*
/*\]*
/*+*
/-[0-9]*
/-[0-9]*
